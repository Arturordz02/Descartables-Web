# Entorno de Sistema y Editores
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# Dependencias y logs
*.log
logs/*
!logs/.htaccess
node_modules/
vendor/

# Archivos de configuración con contraseñas privadas (NUNCA subir a Git)
api/secrets.php
api/vault.local.php
.env
.env.*
*.local.php
scratch/
dist/
*.zip
*.rar

# Copias de seguridad y dumps locales
backups/*
!backups/.htaccess
*.sql.gz

# Subidas de usuarios (uploads) - preservar default.png y archivos .htaccess/.gitkeep
assets/images/productos/prod_*
uploads/*
!uploads/.htaccess
!uploads/.gitkeep
