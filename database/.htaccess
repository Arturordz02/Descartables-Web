# ====================================================================
# PLATAFORMA DESCARTABLES PERUANOS - BASE DE DATOS Y MIGRACIONES
# BLOQUEO TOTAL DE ACCESO HTTP DIRECTO
# ====================================================================

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

<IfModule !mod_authz_core.c>
    Order Deny,Allow
    Deny from all
</IfModule>

Options -Indexes
