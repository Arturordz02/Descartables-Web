# ====================================================================
# PLATAFORMA DESCARTABLES PERUANOS - REGISTROS PRIVADOS DEL SERVIDOR
# BLOQUEO TOTAL DE ACCESO HTTP PÚBLICO
# ====================================================================

# Apache 2.4+
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

# Apache 2.2
<IfModule !mod_authz_core.c>
    Order Deny,Allow
    Deny from all
</IfModule>

Options -Indexes
